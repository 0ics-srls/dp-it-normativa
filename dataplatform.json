{
  "$schema": "https://schemas.dataplatform.0ics.ai/dataplatform/1.json",
  "name": "it-normativa",
  "version": "0.2.7",
  "hostApi": "1",
  "sources": [
    {
      "title": "Normattiva (Poligrafico e Zecca dello Stato)",
      "path": "https://www.normattiva.it",
      "licenses": [
        {
          "name": "source-attribution-required",
          "title": "Reproduction of electronic texts allowed with citation of the source; non-authentic copy (Normattiva legal notice)",
          "path": "https://www.normattiva.it/staticPage/legal"
        }
      ]
    },
    {
      "title": "Gazzetta Ufficiale della Repubblica Italiana",
      "path": "https://www.gazzettaufficiale.it",
      "licenses": [
        {
          "name": "source-attribution-required",
          "title": "Electronic texts may be reproduced if the source is cited; the print edition is the definitive text (Gazzetta Ufficiale notice)",
          "path": "https://www.gazzettaufficiale.it/home"
        }
      ]
    }
  ],
  "sourceTypes": [
    {
      "key": "normattiva-acts",
      "title": "Normattiva acts (fixed set)",
      "configSchema": {
        "type": "object",
        "properties": {
          "acts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "denominazione": { "type": "string", "minLength": 1 },
                "anno": { "type": "integer", "minimum": 1861, "maximum": 2100 },
                "numero": { "type": "integer", "minimum": 1 }
              },
              "required": ["denominazione", "anno", "numero"],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 50
          },
          "collection": { "type": "string", "minLength": 1, "default": "NORMATTIVA" },
          "refreshToken": { "type": "string" },
          "tokenBudget": { "type": "integer", "minimum": 0, "default": 30000, "description": "Hard stop of Jina tokens per embedding Run" }
        },
        "required": ["acts"]
      },
      "x-ui": {
        "order": ["acts", "collection", "refreshToken", "tokenBudget"],
        "labels": { "acts": "Acts", "collection": "Collection label", "refreshToken": "Refresh token", "tokenBudget": "Embedding token budget" },
        "help": {
          "acts": "One act per entry: denominazione (e.g. LEGGE, DECRETO-LEGGE), year, number",
          "collection": "Label stored on every unit (default NORMATTIVA)",
          "refreshToken": "Change this value to fetch all acts again",
          "tokenBudget": "Maximum Jina tokens one Run may spend on embeddings (default 30000)"
        }
      }
    },
    {
      "key": "gu-acts",
      "title": "Gazzetta Ufficiale acts (fixed set)",
      "configSchema": {
        "type": "object",
        "properties": {
          "acts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "dataGU": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
                "codiceRedazionale": { "type": "string", "pattern": "^[0-9A-Z]{6,12}$" }
              },
              "required": ["dataGU", "codiceRedazionale"],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 50
          },
          "collection": { "type": "string", "minLength": 1, "default": "NORMATTIVA" },
          "refreshToken": { "type": "string" },
          "tokenBudget": { "type": "integer", "minimum": 0, "default": 30000, "description": "Hard stop of Jina tokens per embedding Run" }
        },
        "required": ["acts"]
      },
      "x-ui": {
        "order": ["acts", "collection", "refreshToken", "tokenBudget"],
        "labels": { "acts": "Acts", "collection": "Collection label", "refreshToken": "Refresh token", "tokenBudget": "Embedding token budget" },
        "help": {
          "acts": "One act per entry: Gazzetta Ufficiale publication date (YYYY-MM-DD) and codice redazionale (e.g. 21G00001)",
          "collection": "Label stored on every unit (default NORMATTIVA)",
          "refreshToken": "Change this value to fetch all acts again",
          "tokenBudget": "Maximum Jina tokens one Run may spend on embeddings (default 30000)"
        }
      }
    }
  ],
  "pipeline": [
    {
      "step": "detect",
      "class": "git:github.com/0ics-srls/dp-it-normativa-detect@v0.1.1",
      "params": {
        "acts": "${source.config.acts}",
        "state": "${source.state}",
        "refreshToken": "${source.config.refreshToken}"
      },
      "emits": "catalog",
      "retry": { "type": "exponential", "maxAttempts": 3, "interval": "PT5M" },
      "timeout": "PT10M"
    },
    {
      "step": "grab",
      "class": "git:github.com/0ics-srls/dp-it-normativa-grab@v0.2.1",
      "perItem": true,
      "chunkSize": 1,
      "concurrencyLimit": 1,
      "params": {
        "items": "${items}",
        "dir": "${dataRoot}/dp-it-normativa/${source.id}/raw"
      },
      "retry": { "type": "exponential", "maxAttempts": 3, "interval": "PT5M" },
      "timeout": "PT20M",
      "allowedHosts": ["api.normattiva.it", "export.normattiva.it", "www.gazzettaufficiale.it"]
    },
    {
      "step": "convert",
      "class": "git:github.com/0ics-srls/dp-it-normativa-convert@v0.2.1",
      "perItem": true,
      "chunkSize": 1,
      "params": {
        "items": "${items}",
        "dirIn": "${dataRoot}/dp-it-normativa/${source.id}/raw",
        "dirOut": "${dataRoot}/dp-it-normativa/${source.id}/plan",
        "collection": "${source.config.collection}"
      },
      "timeout": "PT20M"
    },
    {
      "step": "ingest",
      "class": "git:github.com/0ics-srls/dp-it-normativa-ingest@v0.1.3",
      "perItem": true,
      "chunkSize": 1,
      "db": "dataset",
      "params": {
        "items": "${items}",
        "dirIn": "${dataRoot}/dp-it-normativa/${source.id}/plan",
        "connString": "${dataset.connString}",
        "schema": "ds_it_normativa"
      },
      "timeout": "PT30M",
      "produces": ["ds_it_normativa.acts", "ds_it_normativa.units", "ds_it_normativa.unit_versions", "ds_it_normativa.akn_documents"]
    },
    {
      "step": "embed",
      "class": "git:github.com/0ics-srls/dp-lex-embed@dp-p7.1",
      "perItem": true,
      "chunkSize": 1,
      "concurrencyLimit": 1,
      "db": "dataset",
      "secrets": ["JINA_API_KEY"],
      "params": {
        "items": "${items}",
        "connString": "${dataset.connString}",
        "table": "ds_it_normativa.units",
        "keyColumn": "urn",
        "textColumns": ["text_contextual"],
        "vectorColumn": "embedding",
        "tokenBudget": "${source.config.tokenBudget}",
        "jinaApiKey": "${secret.JINA_API_KEY}"
      },
      "retry": { "type": "exponential", "maxAttempts": 3, "interval": "PT2M" },
      "timeout": "PT30M",
      "heartbeatMaxSeconds": 600,
      "produces": ["ds_it_normativa.units"]
    }
  ],
  "catalog": { "noveltyKey": "actId|version", "retryFailed": "newUrlOnly" },
  "releases": {
    "breakingChanges": {
      "0.2.7": {
        "message": "guide text only: Tool names written with the real hyphenated dataset prefix (it-normativa_search); no Tool, schema or data change",
        "scopedImpact": "it-normativa_guide text"
      },
      "0.2.6": {
        "message": "Deep link of an inserted article is ~art25bis (Normattiva ignores the hyphen form and shows the base article): migration 0003 recomputes units.deep_link; the act Screen route carries the raw urn; no Tool or column is added or removed",
        "scopedImpact": "deep_link values of -bis/-ter articles, it-normativa UI"
      },
      "0.2.5": {
        "message": "Act Screen: version timeline spacing (date and unit count were glued); no Tool, column or table is changed",
        "scopedImpact": "it-normativa UI"
      },
      "0.2.4": {
        "message": "embed conformance run carries the table params; no Tool, column, table or Screen is changed",
        "scopedImpact": "registration"
      },
      "0.2.3": {
        "message": "tests/conformance/embed.json added (the protocol 1.1 embed step needs a conformance file); no Tool, column, table or Screen is changed",
        "scopedImpact": "registration"
      },
      "0.2.2": {
        "message": "ingest class 0.1.3: its tests collect inside the ProcMon test container; no Tool, column, table or Screen is changed",
        "scopedImpact": "pipeline classes"
      },
      "0.2.1": {
        "message": "Class manifests shortened to the ProcMon description limit (grab 0.2.1, convert 0.2.1, ingest 0.1.2); no Tool, column, table or Screen is changed",
        "scopedImpact": "pipeline classes"
      },
      "0.2.0": {
        "message": "Screens added: acts list, act detail with versions and ingest status (Console menu Normativa Italia); no Tool, column or table is changed",
        "scopedImpact": "it-normativa UI"
      },
      "0.1.0": {
        "message": "Initial release: Normattiva acts and Gazzetta Ufficiale acts (detect, grab, convert, ingest, embed), schema ds_it_normativa (acts, units, unit_versions, edges, akn_documents) and 11 Tools (search, act_outline, acts_find, article, comma, refs, version_at_date, act_akn, guide, act_versions, ingest_status); no Screens yet",
        "scopedImpact": "new package"
      }
    }
  },
  "dataset": { "schema": "ds_it_normativa", "migrations": "schema/migrations", "contract": "serving/dataset.odcs.yaml" },
  "ui": {
    "hostUiApi": "1",
    "entry": "ui/dist/main.js",
    "styles": ["ui/dist/styles.css"],
    "menu": {
      "label": { "sk": "Normatíva Taliansko", "en": "Italian legislation", "it": "Normativa italiana" },
      "icon": "pi pi-book",
      "order": 110
    },
    "screens": [
      { "id": "acts", "element": "dp-it-normativa-acts", "label": { "sk": "Akty", "en": "Acts", "it": "Atti" }, "icon": "pi pi-list", "default": true },
      { "id": "act", "element": "dp-it-normativa-act", "label": { "sk": "Detail aktu", "en": "Act detail", "it": "Dettaglio atto" }, "icon": "pi pi-file" },
      { "id": "status", "element": "dp-it-normativa-status", "label": { "sk": "Stav načítania", "en": "Ingest status", "it": "Stato dell'ingestione" }, "icon": "pi pi-chart-bar" }
    ],
    "permissions": [
      "tools:acts_find",
      "tools:act_outline",
      "tools:act_versions",
      "tools:ingest_status",
      "tools:article",
      "tools:act_akn",
      "navigate"
    ]
  }
}
