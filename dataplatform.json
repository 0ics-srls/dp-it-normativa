{
  "$schema": "https://schemas.dataplatform.0ics.ai/dataplatform/1.json",
  "name": "it-normativa",
  "version": "0.1.0",
  "hostApi": "1",
  "sources": [
    {
      "title": "Normattiva (Poligrafico e Zecca dello Stato)",
      "path": "https://www.normattiva.it",
      "licenses": [
        {
          "name": "source-attribution-required",
          "title": "Reproduction of electronic texts allowed with citation of the source; non-authentic copy (Normattiva legal notice)",
          "path": "https://www.normattiva.it/staticPage/legal"
        }
      ]
    },
    {
      "title": "Gazzetta Ufficiale della Repubblica Italiana",
      "path": "https://www.gazzettaufficiale.it",
      "licenses": [
        {
          "name": "source-attribution-required",
          "title": "Electronic texts may be reproduced if the source is cited; the print edition is the definitive text (Gazzetta Ufficiale notice)",
          "path": "https://www.gazzettaufficiale.it/home"
        }
      ]
    }
  ],
  "sourceTypes": [
    {
      "key": "normattiva-acts",
      "title": "Normattiva acts (fixed set)",
      "configSchema": {
        "type": "object",
        "properties": {
          "acts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "denominazione": { "type": "string", "minLength": 1 },
                "anno": { "type": "integer", "minimum": 1861, "maximum": 2100 },
                "numero": { "type": "integer", "minimum": 1 }
              },
              "required": ["denominazione", "anno", "numero"],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 50
          },
          "collection": { "type": "string", "minLength": 1, "default": "NORMATTIVA" },
          "refreshToken": { "type": "string" }
        },
        "required": ["acts"]
      },
      "x-ui": {
        "order": ["acts", "collection", "refreshToken"],
        "labels": { "acts": "Acts", "collection": "Collection label", "refreshToken": "Refresh token" },
        "help": {
          "acts": "One act per entry: denominazione (e.g. LEGGE, DECRETO-LEGGE), year, number",
          "collection": "Label stored on every unit (default NORMATTIVA)",
          "refreshToken": "Change this value to fetch all acts again"
        }
      }
    },
    {
      "key": "gu-acts",
      "title": "Gazzetta Ufficiale acts (fixed set)",
      "configSchema": {
        "type": "object",
        "properties": {
          "acts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "dataGU": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
                "codiceRedazionale": { "type": "string", "pattern": "^[0-9A-Z]{6,12}$" }
              },
              "required": ["dataGU", "codiceRedazionale"],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 50
          },
          "collection": { "type": "string", "minLength": 1, "default": "NORMATTIVA" },
          "refreshToken": { "type": "string" }
        },
        "required": ["acts"]
      },
      "x-ui": {
        "order": ["acts", "collection", "refreshToken"],
        "labels": { "acts": "Acts", "collection": "Collection label", "refreshToken": "Refresh token" },
        "help": {
          "acts": "One act per entry: Gazzetta Ufficiale publication date (YYYY-MM-DD) and codice redazionale (e.g. 21G00001)",
          "collection": "Label stored on every unit (default NORMATTIVA)",
          "refreshToken": "Change this value to fetch all acts again"
        }
      }
    }
  ],
  "dataset": { "schema": "ds_it_normativa", "migrations": "schema/migrations", "contract": "serving/dataset.odcs.yaml" }
}
